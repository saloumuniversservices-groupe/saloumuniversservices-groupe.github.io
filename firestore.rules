rules_version = '2';
// Règles du projet suns-boutique : site, boutiques et logiciel de gestion.
// Propriétaires : voient tout, invitent et retirent le personnel. Personne ne peut effacer le journal.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function me() { return request.auth.token.email.lower(); }
    function isOwner() { return signedIn() && me() in ['mandiayembow4@gmail.com', 'sunsgroupesarl@gmail.com']; }
    function staffDoc() { return /databases/$(db)/documents/staff/$(me()); }
    function isStaff() { return signedIn() && exists(staffDoc()) && get(staffDoc()).data.active == true; }
    function role() { return get(staffDoc()).data.role; }
    function hasRole(list) { return isOwner() || (isStaff() && role() in list); }
    // Ancienne liste d'administrateurs de la boutique (admin.html), gardée le temps de la bascule.
    function isLegacyAdmin() { return signedIn() && exists(/databases/$(db)/documents/admins/$(me())); }
    function isAdmin() { return isOwner() || isLegacyAdmin() || hasRole(['vendeur', 'magasinier', 'agro']); }
    function str(v, max) { return v is string && v.size() <= max; }

    function validOrder() {
      let o = request.resource.data;
      return o.keys().hasOnly(['no','type','cat','items','subtotal','fee','total','zone','address','note','pay','date','slot','accept','service','details','name','phone','lang','status','createdAt'])
        && o.status == 'nouvelle' && o.accept == true
        && o.type in ['commande', 'devis']
        && o.cat in ['bmw', 'agro', 'tilapia', 'transport']
        && str(o.no, 20) && str(o.name, 80) && o.name.size() >= 2 && str(o.phone, 25)
        && o.items is list && o.items.size() <= 60
        && o.total is number && o.total >= 0
        && (!('address' in o) || str(o.address, 200))
        && (!('details' in o) || str(o.details, 1000))
        && (!('note' in o) || str(o.note, 500));
    }
    function validTrack(no) {
      let t = request.resource.data;
      return t.keys().hasOnly(['status','type','cat','total','date','slot','zone','ph4','createdAt'])
        && t.status == 'nouvelle' && str(t.ph4, 4) && t.total is number && no.size() <= 20;
    }

    // ---------- Boutiques ----------
    // Produits : magasinier (tout), responsable agro (fruits, légumes, tilapia), vendeur (seulement le stock, pour la caisse).
    function canStock(cat) { return isOwner() || isLegacyAdmin() || hasRole(['magasinier']) || (hasRole(['agro']) && cat in ['agro', 'tilapia']); }
    match /products/{id} {
      allow read: if true;
      allow create: if canStock(request.resource.data.cat);
      allow update: if (canStock(resource.data.cat) && canStock(request.resource.data.cat))
        || (hasRole(['vendeur', 'atelier']) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'qty', 'inStock', 'updatedAt', 'updatedBy']));
      allow delete: if isOwner();
    }
    // Prix d'achat : jamais visibles par le public.
    match /productsPrivate/{id} {
      allow read: if hasRole(['magasinier', 'comptable', 'agro']) || isLegacyAdmin();
      allow write: if hasRole(['magasinier', 'agro']) || isLegacyAdmin();
    }
    // Mouvements de stock : chacun écrit les siens, personne ne modifie ni n'efface.
    match /stockMoves/{id} {
      allow read: if isOwner() || isStaff();
      allow create: if (hasRole(['magasinier', 'agro', 'vendeur', 'atelier']) || isLegacyAdmin())
        && request.resource.data.by == me()
        && request.resource.data.at == request.time
        && request.resource.data.delta is number
        && request.resource.data.type in ['entree', 'sortie', 'correction', 'vente', 'retour', 'transfert', 'import'];
      allow update, delete: if false;
    }
    match /settings/{id} { allow read: if true; allow write: if isAdmin(); }
    // Caisse : ventes numérotées. Personne ne les efface ; seul un propriétaire peut annuler (motif gardé).
    match /counters/{id} {
      allow read: if isOwner() || isStaff();
      allow create, update: if (isOwner() || isStaff())
        && request.resource.data.keys().hasOnly(['n'])
        && request.resource.data.n == (resource == null ? 1 : resource.data.n + 1);
    }
    match /sales/{id} {
      allow read: if hasRole(['vendeur', 'magasinier', 'agro', 'comptable', 'atelier']);
      allow create: if hasRole(['vendeur', 'magasinier', 'agro', 'atelier'])
        && request.resource.data.by == me()
        && request.resource.data.at == request.time
        && request.resource.data.status == 'validee'
        && request.resource.data.total is number && request.resource.data.total >= 0
        && request.resource.data.items is list && request.resource.data.items.size() <= 100
        && request.resource.data.pay in ['especes', 'wave', 'om', 'credit'];
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelReason', 'cancelBy', 'cancelAt'])
        && request.resource.data.status == 'annulee';
      allow delete: if false;
    }
    match /orders/{id} {
      allow create: if validOrder();
      allow read: if isAdmin() || hasRole(['comptable']);
      allow update: if isAdmin();
      allow delete: if isOwner();
    }
    match /track/{no} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if validTrack(no) && !exists(/databases/$(db)/documents/track/$(no));
      allow update: if isAdmin();
      allow delete: if isOwner();
    }
    match /admins/{email} {
      allow read: if isAdmin();
      allow write: if isOwner();
    }

    // Clients, paiements de créances, retours clients.
    function sellers() { return hasRole(['vendeur', 'magasinier', 'agro', 'comptable', 'atelier']); }
    function own() { return request.resource.data.by == me() && request.resource.data.at == request.time; }
    match /clients/{id} { allow read: if isOwner() || isStaff(); allow create, update: if sellers(); allow delete: if isOwner(); }
    match /payments/{id} {
      allow read: if sellers();
      allow create: if sellers() && own() && request.resource.data.amount is number && request.resource.data.amount > 0;
      allow update, delete: if false;
    }
    match /returns/{id} {
      allow read: if sellers();
      allow create: if hasRole(['vendeur', 'magasinier', 'agro']) && own() && request.resource.data.amount is number && request.resource.data.amount >= 0;
      allow update, delete: if false;
    }
    // Achats, fournisseurs, paiements fournisseurs, dépenses.
    function buyers() { return hasRole(['magasinier', 'comptable', 'agro']); }
    match /suppliers/{id} { allow read: if isOwner() || isStaff(); allow create, update: if buyers(); allow delete: if isOwner(); }
    match /purchases/{id} {
      allow read: if buyers();
      allow create: if buyers() && own();
      allow update: if buyers() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'receivedAt', 'receivedBy', 'returns', 'avoir'])
        && (request.resource.data.status != 'annulee' || isOwner());
      allow delete: if false;
    }
    match /supplierPayments/{id} {
      allow read: if buyers();
      allow create: if buyers() && own() && request.resource.data.amount is number && request.resource.data.amount > 0;
      allow update, delete: if false;
    }
    match /expenses/{id} {
      allow read: if hasRole(['comptable']) || (isStaff() && resource.data.by == me());
      allow create: if hasRole(['comptable', 'magasinier', 'vendeur', 'agro', 'atelier']) && own() && request.resource.data.amount is number && request.resource.data.amount > 0 && request.resource.data.status == 'ok';
      allow update: if isOwner() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelReason', 'cancelBy']) && request.resource.data.status == 'annulee';
      allow delete: if false;
    }
    // Atelier : véhicules, réparations, rendez-vous.
    function garage() { return hasRole(['atelier', 'vendeur', 'magasinier']); }
    match /vehicles/{id} { allow read: if isOwner() || isStaff(); allow create, update: if garage(); allow delete: if isOwner(); }
    match /repairs/{id} { allow read: if garage() || hasRole(['comptable']); allow create, update: if garage(); allow delete: if false; }
    match /appointments/{id} { allow read: if garage(); allow create, update: if garage(); allow delete: if isOwner(); }

    // ---------- Logiciel de gestion ----------
    // Personnel : seuls les propriétaires invitent, modifient ou retirent.
    // La personne invitée peut seulement lire sa fiche et noter sa dernière connexion.
    match /staff/{email} {
      allow read: if isOwner() || (signedIn() && me() == email);
      allow create, update, delete: if isOwner()
        && (request.resource == null || (request.resource.data.role in ['vendeur','magasinier','atelier','comptable','agro']
            && str(request.resource.data.email, 120) && request.resource.data.email == email));
      allow update: if signedIn() && me() == email && exists(staffDoc())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen', 'status', 'name'])
        && (!('status' in request.resource.data) || request.resource.data.status in ['actif', resource.data.status])
        && str(request.resource.data.get('name', ''), 80);
    }
    // Journal : chacun écrit ses propres actions, personne ne modifie ni n'efface. Lecture : propriétaires.
    match /journal/{id} {
      allow create: if (isOwner() || isStaff())
        && request.resource.data.keys().hasOnly(['type', 'text', 'by', 'byName', 'at', 'extra'])
        && request.resource.data.by == me()
        && request.resource.data.at == request.time
        && str(request.resource.data.text, 300)
        && request.resource.data.type in ['equipe', 'connexion', 'argent', 'stock', 'vente', 'achat', 'atelier', 'annulation', 'reglage'];
      allow read: if isOwner();
      allow update, delete: if false;
    }
  }
}
